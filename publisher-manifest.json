          "body": "<style>\n* {box-sizing: border-box;margin: 0;padding: 0}\nbody {background-color: #f3f4f8;color: #16171d;font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Lantinghei SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;line-height: 1.8;letter-spacing: -0.01em;padding-bottom: 90px;-webkit-font-smoothing: antialiased}\na {color: #6e00ff;text-decoration: none}\na:hover {text-decoration: underline}\n.site-wrapper {max-width: 1040px;margin: 0 auto;padding: 48px 24px 80px 24px}\n.hero-dashboard {display: grid;grid-template-columns: 1.4fr 1fr;gap: 24px;margin-bottom: 56px;align-items: stretch}\n@media (max-width: 860px) {\n  .hero-dashboard {grid-template-columns: 1fr}\n}\n.hero-main-card {background: #ffffff;padding: 48px 40px;border-radius: 12px;box-shadow: 0 4px 20px rgba(22, 23, 29, 0.04);border-left: 8px solid #6e00ff;display: flex;flex-direction: column;justify-content: space-between}\n.meta-tag {display: inline-block;font-size: 11px;font-weight: 700;letter-spacing: 0.12em;text-transform: uppercase;color: #6e00ff;background: #f1e9ff;padding: 4px 10px;border-radius: 4px;margin-bottom: 20px;width: fit-content}\nh1 {font-size: 34px;line-height: 1.35;font-weight: 800;color: #0f1015;margin-bottom: 24px}\n.hero-essay {font-size: 16px;color: #4b4f5f;line-height: 1.85}\n.dashboard-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 16px}\n@media (max-width: 520px) {\n  .dashboard-grid {grid-template-columns: 1fr}\n}\n.telemetry-card {background: #ffffff;padding: 24px;border-radius: 12px;box-shadow: 0 4px 16px rgba(22, 23, 29, 0.03);border-left: 5px solid #8e3ff7;display: flex;flex-direction: column;justify-content: space-between}\n.telemetry-label {font-size: 12px;font-weight: 600;color: #6b7082;text-transform: uppercase;letter-spacing: 0.05em;margin-bottom: 8px}\n.telemetry-value {font-size: 26px;font-weight: 800;color: #12131a;line-height: 1.2;margin-bottom: 8px}\n.telemetry-foot {font-size: 13px;color: #7a7f92;line-height: 1.